<Window x:Class="TurboGet.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt TurboGet"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgSecondary}"
        Foreground="{StaticResource TextPrimary}">
    <StackPanel Margin="20">
        <TextBlock Text="Thư mục lưu mặc định:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtDefaultDir" Grid.Column="0" Height="34"/>
            <Button Grid.Column="1" Content="Chọn..." Style="{StaticResource ToolbarButton}"
                    Margin="8,0,0,0" Click="BtnBrowse_Click"/>
        </Grid>

        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Số luồng tải HTTP mặc định:" Foreground="{StaticResource TextSecondary}"/>
            <TextBlock x:Name="LblThreads" Text="8 luồng" Foreground="{StaticResource AccentHoverBrush}"
                       FontWeight="Bold" HorizontalAlignment="Right"/>
        </DockPanel>
        <Slider x:Name="SliderThreads" Minimum="1" Maximum="32" Value="8" IsSnapToTickEnabled="True"
                TickFrequency="1" Margin="0,0,0,14" ValueChanged="SliderThreads_ValueChanged"/>

        <TextBlock Text="Giới hạn tốc độ tải (KB/s, nhập 0 = Không giới hạn):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtSpeedLimit" Height="34" Margin="0,0,0,14"/>

        <CheckBox x:Name="ChkStopSeeding"
                  Content="Tự động dừng Seed khi tải xong Torrent (giống IDM)"
                  Foreground="{StaticResource TextPrimary}"
                  FontSize="13"
                  Margin="0,0,0,10"/>

        <CheckBox x:Name="ChkMinimizeToTray"
                  Content="Thu nhỏ xuống khay hệ thống khi bấm nút đóng (X)"
                  Foreground="{StaticResource TextPrimary}"
                  FontSize="13"
                  Margin="0,0,0,10"/>

        <CheckBox x:Name="ChkStartWithWindows"
                  Content="Khởi động cùng Windows (tự chạy ngầm ở khay hệ thống)"
                  Foreground="{StaticResource TextPrimary}"
                  FontSize="13"
                  Margin="0,0,0,10"/>

        <CheckBox x:Name="ChkNotifyOnComplete"
                  Content="Hiện thông báo khi tải hoàn thành"
                  Foreground="{StaticResource TextPrimary}"
                  FontSize="13"
                  Margin="0,0,0,18"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource ToolbarButton}" Width="90" Click="BtnCancel_Click"/>
            <Button Content="Lưu cài đặt" Style="{StaticResource PrimaryButton}" Width="115" Margin="0" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
